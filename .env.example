# Copiá este archivo a .env.local y completá los valores reales.
# Nunca commitees .env.local. En producción, estas variables van en Vercel.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Semana 1) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Único email autorizado para entrar con magic link
ALLOWED_EMAIL=

# --- Anthropic (Semana 1) ---
ANTHROPIC_API_KEY=

# --- OpenAI, transcripción (Semana 2) ---
OPENAI_API_KEY=

# --- Telegram (Semana 2) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# --- Google OAuth (Semana 2) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Clave para cifrar los tokens de OAuth guardados en la tabla integrations
INTEGRATIONS_ENCRYPTION_KEY=

# --- Tareas programadas (Semana 3) ---
CRON_SECRET=
